    {
      "id": "phone_business_profile",
      "kind": "meta_operation",
      "operation": "graph_get",
      "input": {
        "graph_operation": "phone.business_profile",
        "path_params": { "phone_number_id": "phone-contract" },
        "query": { "fields": "messaging_product,about,address,description,email,profile_picture_url,websites,vertical" },
        "token": "waba-contract-token"
      },
      "expected_request": {
        "method": "GET",
        "path": "/v25.0/phone-contract/whatsapp_business_profile",
        "query": { "fields": "messaging_product,about,address,description,email,profile_picture_url,websites,vertical" }
      },
      "expected_response": { "success": true, "data": [] }
    }
  ]
}
