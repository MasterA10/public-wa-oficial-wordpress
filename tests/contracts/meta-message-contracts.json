        "method": "GET",
        "path": "/v25.0/waba-contract/phone_numbers",
        "query": { "fields": "id,display_phone_number,verified_name,status,quality_rating" }
      },
      "expected_response": { "success": true, "data": [] }
    },
    {
      "id": "waba_subscribed_apps_list",
      "kind": "meta_operation",
      "operation": "graph_get",
      "input": {
        "graph_operation": "waba.get_subscribed_apps",
        "path_params": { "waba_id": "waba-contract" },
        "query": {},
        "token": "waba-contract-token"
      },
      "expected_request": {
        "method": "GET",
        "path": "/v25.0/waba-contract/subscribed_apps"
      },
      "expected_response": { "success": true, "data": [] }
    },
    {
      "id": "phone_details",
      "kind": "meta_operation",
      "operation": "graph_get",
      "input": {
        "graph_operation": "phone.get",
        "path_params": { "phone_number_id": "phone-contract" },
        "query": { "fields": "id,display_phone_number,verified_name,status,quality_rating" },
        "token": "waba-contract-token"
      },
      "expected_request": {
        "method": "GET",
        "path": "/v25.0/phone-contract",
